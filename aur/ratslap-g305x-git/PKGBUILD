# Maintainer: Pablo Barraza <pablo.barraza@protonmail.com>
# AUR package: builds the latest tagged release from the git repository.
# Submit with: makepkg --printsrcinfo > .SRCINFO  (then update the pinned
# tag below when a new release comes out).

pkgname=ratslap-g305x-git
pkgver=0.1.0
pkgrel=1
pkgdesc="Configure the Logitech G305 X on Linux: buttons, DPI, report rate, profiles (HID++, no daemon)"
arch=('x86_64')
url="https://github.com/pablobc-mx/ratslap-g305x"
license=('GPL-3.0-or-later')
depends=('glibc')
makedepends=('git' 'gcc' 'make')
provides=("ratslap-g305x=$pkgver")
conflicts=('ratslap-g305x')
source=("git+${url}.git#tag=v${pkgver}")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/${pkgname%-git}"
    git describe --tags --long 2>/dev/null | sed 's/^v//;s/-/.r/;s/-/./' || echo "$pkgver"
}

build() {
    make -C "$srcdir/${pkgname%-git}"
}

check() {
    make -C "$srcdir/${pkgname%-git}" test
}

package() {
    cd "$srcdir/${pkgname%-git}"
    make clean
    make
    install -Dm755 ratslap-g305x "$pkgdir/usr/bin/ratslap-g305x"
    install -Dm644 42-g305x.rules "$pkgdir/usr/lib/udev/rules.d/42-g305x.rules"
    install -Dm644 README.md "$pkgdir/usr/share/doc/ratslap-g305x/README.md"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/ratslap-g305x-git/LICENSE"
}
