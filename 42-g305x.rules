# 42-g305x.rules — device access for ratslap-g305x (Logitech HID++ devices)
#
# Gives the user seated at the screen (uaccess) read/write access to every
# Logitech hidraw device. This is the same rule Solaar and OpenGMice ship,
# and it covers the whole G305 X family regardless of the exact PID:
#
#   046d:c547  LIGHTSPEED USB receiver                      (owner-confirmed)
#   046d:40bb  G305 X LIGHTSPEED wireless wpid              (owner-confirmed)
#   046d:40bc  G304 X wireless wpid (same family, Asia)     (compatible)
#   046d:c0a4  G305 X SUPERLIGHT wired USB-C               (owner-confirmed)
#   046d:c0a7  G304 X wired USB-C                          (expected, unconfirmed)
#   046d:b046  G305 X SUPERLIGHT (Bluetooth)
#   046d:4074  G305 LIGHTSPEED (original, profile format 3)
#
# ratslap-g305x discovers devices at runtime — it never gates on a PID
# table — so a not-yet-listed variant works too once it can be opened.
#
# Install (Arch):
#   sudo install -Dm644 42-g305x.rules /usr/lib/udev/rules.d/42-g305x.rules
#   sudo udevadm control --reload && sudo udevadm trigger
#   # then replug the mouse or its receiver
#
# Note: this grants the logged-in user raw access to ALL Logitech HID++
# devices, including Logitech keyboards. On a shared machine, leave the
# rule out and run ratslap-g305x with sudo instead.

KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", TAG+="uaccess"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", KERNELS=="*:046D:*", TAG+="uaccess"
